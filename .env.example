# Copy to .env and fill in your own values. Never commit .env.
# Sepolia RPC endpoint (Alchemy, Infura, or any provider)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Private key of a throwaway deployer wallet that holds only Sepolia test ETH
PRIVATE_KEY=
# For contract verification on Etherscan
ETHERSCAN_API_KEY=
# Set to true to print a gas report during tests
REPORT_GAS=false
