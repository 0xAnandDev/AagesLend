# Copy to .env and fill in. Never commit .env. Foundry loads it automatically.

# Arbitrum Sepolia RPC (public endpoint works; Alchemy/Infura are more reliable)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Etherscan API v2 key (from etherscan.io). The same key verifies on Arbiscan.
ETHERSCAN_API_KEY=

# Optional: real Chainlink proxy addresses on Arbitrum Sepolia, from
# https://docs.chain.link/data-feeds/price-feeds/addresses?network=arbitrum (pick "Arbitrum Sepolia").
# Leave empty to deploy mock feeds you can move with script/SetMockPrice.s.sol (handy for liquidation demos).
ETH_USD_FEED=
BTC_USD_FEED=
USDC_USD_FEED=

# Optional: Chainlink only publishes the L2 sequencer uptime feed on mainnets
# (Arbitrum One: 0xFdB631F5EE196F0ed6FAa767959853A9F217697D). Leave empty on testnet to deploy a mock.
SEQUENCER_UPTIME_FEED=

# The deployer key is NOT stored here. Import it once into Foundry's encrypted keystore:
#   cast wallet import deployer --interactive
# and deploy with --account deployer (see package.json "deploy:arbitrum-sepolia").
