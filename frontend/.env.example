# Copy to frontend/.env.local. Only VITE_* variables reach the browser, so never put secrets here.

# Which chains the app offers: "local", "arbitrumSepolia", or both comma-separated.
VITE_CHAINS=local,arbitrumSepolia

# Optional dedicated RPC for Arbitrum Sepolia (public endpoint is used if empty)
VITE_ARBITRUM_SEPOLIA_RPC_URL=

# Optional: WalletConnect Cloud project id (https://cloud.reown.com) to enable mobile wallets via QR code
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: Ponder indexer URL for the activity feed (see ../indexer)
VITE_INDEXER_URL=http://localhost:42069

# Local development only: show a "Use Anvil dev account" button that connects Anvil account #1 (account #0 is the deployer that seeds liquidity)
VITE_DEV_WALLET=true
