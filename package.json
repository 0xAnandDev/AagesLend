{
  "name": "aageslend",
  "version": "0.2.0",
  "description": "AagesLend: an over-collateralized lending protocol (supply, borrow, liquidate) with a React frontend",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "test:gas": "forge test --gas-report",
    "coverage": "forge coverage --report summary",
    "fmt": "forge fmt",
    "snapshot": "forge snapshot",
    "anvil": "anvil",
    "deploy:local": "forge script script/Deploy.s.sol:Deploy --rpc-url localhost --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 --broadcast",
    "deploy:arbitrum-sepolia": "forge script script/Deploy.s.sol:Deploy --rpc-url arbitrum_sepolia --account deployer --broadcast --verify -vvv",
    "export-abis": "forge build && node scripts/export-abis.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "forge-std": "github:foundry-rs/forge-std#v1.9.7"
  },
  "engines": {
    "node": ">=20"
  }
}
